# Deploy headers for Cloudflare Pages / Netlify (both read this file).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), browsing-topics=()
  Cache-Control: public, max-age=3600

# Static assets change rarely — cache them longer, revalidate in the background.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff

# Embeddable widgets must be framable by other sites — that is the entire
# point of them. X-Frame-Options above is a blanket DENY and has no
# "allow any origin" value, so it is removed here and replaced with the
# modern equivalent (frame-ancestors), scoped to just this directory.
# Everything outside /embed/ keeps the DENY.
/embed/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors *
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=3600
